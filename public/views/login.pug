extends layout
include includes/fields
block content
  .auth-layout
    section.auth-panel
      p.eyebrow Votre carnet
      h1 Se connecter
      p.muted Retrouvez vos cartes et votre bibliothèque.
      form(action='/api/user/login' method='post')
        input(type='hidden' name='_csrf' value=csrfToken)
        +field('email', 'Adresse email', 'email', 'email', true)
        +field('password', 'Mot de passe', 'password', 'current-password', true)
        button.button.full(type='submit') Ouvrir mon carnet
      p.form-foot Pas encore de compte ? #[a(href='/register') Créer mon compte]
