header.site-header
  a.brand(href=user ? '/businessCard/savedBusinessCard' : '/login')
    span.brand-symbol(aria-hidden='true') C
    span Carnet de cartes de visite
  button#menu-toggle.menu-toggle(type='button' aria-controls='site-nav' aria-expanded='false' aria-label='Ouvrir le menu') Menu
  nav#site-nav(aria-label='Navigation du carnet')
    if user
      p.nav-caption Contacts
      a(class=currentPath === '/businessCard/savedBusinessCard' || currentPath.endsWith('/organize') || currentPath.startsWith('/businessCard/import') ? 'active' : '' href='/businessCard/savedBusinessCard') Ma bibliothèque
      a(class=currentPath === '/businessCard' ? 'active' : '' href='/businessCard') Découvrir
      p.nav-caption Mes coordonnées
      a(class=currentPath === '/businessCard/mine' || currentPath.endsWith('/edit') || currentPath.endsWith('/addBusinessCard') ? 'active' : '' href='/businessCard/mine') Mes cartes
      a(class=currentPath.startsWith('/api/user') ? 'active' : '' href=`/api/user/${user.id}`) Mon profil
      .account-tools
        span.account-avatar(aria-hidden='true')= user.name.slice(0, 1).toUpperCase()
        span.account-name= user.name
        form(action='/api/user/logout' method='post')
          input(type='hidden' name='_csrf' value=csrfToken)
          button.nav-logout(type='submit') Déconnexion
    else
      a(href='/login' class=currentPath === '/login' ? 'active' : '') Connexion
      a(href='/register' class=currentPath === '/register' ? 'active' : '') Créer un compte
