head
  meta(charset='utf-8')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  meta(name='description' content='Créez vos cartes de visite, découvrez des contacts et gardez leurs coordonnées dans votre bibliothèque.')
  title #{title || (currentPath === '/login' ? 'Connexion' : currentPath === '/register' ? 'Créer un compte' : 'Vos contacts')} | Carnet de cartes de visite
  link(rel='stylesheet' href='/css/styles.css')
  script(src='/js/site.js' defer)

  meta(name="session-key" content=sessionState ? sessionState.key : "visitor")
  meta(name="identity-key" content=sessionState ? sessionState.identity : "visitor")
  meta(name="session-expires" content=sessionState ? sessionState.expiresAt : 0)
