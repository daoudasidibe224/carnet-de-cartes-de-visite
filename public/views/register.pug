extends layout
include includes/fields
block content
  .auth-layout
    section.auth-panel
      p.eyebrow Nouveau carnet
      h1 Créer mon compte
      p.muted Un email et un mot de passe suffisent. Vous compléterez vos coordonnées en créant une carte.
      form(action='/api/user/register' method='post')
        input(type='hidden' name='_csrf' value=csrfToken)
        +field('email', 'Adresse email', 'email', 'email', true)
        +field('password', 'Mot de passe (8 caractères minimum)', 'password', 'new-password', true)
        +field('name', 'Nom (facultatif)', 'text', 'name', false)
        button.button.full(type='submit') Créer mon compte
      p.form-foot Déjà inscrit ? #[a(href='/login') Se connecter]
