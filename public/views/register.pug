extends layout
include includes/fields
block content
  .auth-layout
    section.auth-panel
      p.eyebrow Nouveau carnet
      h1 Créer mon compte
      p.muted Votre profil reste privé. Vous choisirez les coordonnées à publier sur vos cartes.
      form(action='/api/user/register' method='post')
        input(type='hidden' name='_csrf' value=csrfToken)
        +contactFields()
        +field('password', 'Mot de passe (8 caractères minimum)', 'password', 'new-password', true)
        +field('confirmPassword', 'Confirmer le mot de passe', 'password', 'new-password', true)
        button.button.full(type='submit') Créer mon compte
      p.form-foot Déjà inscrit ? #[a(href='/login') Se connecter]
