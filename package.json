{
  "name": "carnet-cartes-de-visite",
  "version": "2.0.0",
  "private": true,
  "description": "Carnet de cartes de visite et biblioth\u00e8que personnelle",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node scripts/dev.js",
    "lint": "eslint app.ts server.ts types.ts controllers middleware models routes utils services client shared",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.server.json && node scripts/build-client.js",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "test:e2e": "node test/e2e.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.1",
    "pug": "^3.0.4",
    "validator": "^13.15.35",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
